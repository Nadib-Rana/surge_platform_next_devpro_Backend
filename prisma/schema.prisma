generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- Enums ---
enum UserRole {
  customer
  vendor
  staff
}

enum Gender {
  male
  female
  other
}

enum TokenType {
  email_verification
  password_reset
  login_otp
}

enum TokenDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum EnrollmentStatus {
  ACTIVE
  EXPIRED
}

enum PaymentMethod {
  COD
  SQUARE
}

enum PaymentStatus {
  PENDING
  UNPAID
  PAID
}

enum OrderStatus {
  PLACED
  CONFIRMED
  CANCELLED
  COMPLETED
}

// --- Models ---

model User {
  id            String    @id @default(uuid()) @db.Uuid
  fullName      String?   @map("full_name")
  email         String    @unique
  phoneNumber   String?   @unique @map("phone")
  password      String    @map("password")
  role          UserRole  @default(customer)
  age           Int
  gender        Gender
  avatarKey     String?   @map("profile_image")
  isVerified    Boolean   @default(false) @map("is_verified")
  createdAt     DateTime  @default(now()) @map("created_at")

  // Website-er jonno lagbe
  verificationTokens   VerificationToken[]
  enrollments          Enrollment[]
  cartItems            CartItem[]
  orders               Order[]
  notificationSettings NotificationSetting?

  @@map("users")
}

model VerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  type      TokenType
  expiresAt DateTime  @map("expiresAt")
  used      Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("createdAt")

  @@map("verification_tokens")
  @@index([token])
  @@index([userId, type, used])
}

model NotificationSetting {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @unique @map("user_id") @db.Uuid
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailNotification Boolean @default(true) @map("email_notifications")
  // Website e push bolte browser push bujhay
  pushNotification  Boolean @default(true) @map("push_notifications")

  @@map("notification_settings")
}

model ClassCategory {
  id           String                  @id @default(uuid()) @db.Uuid
  title        String
  description  String?
  thumbnailKey String?                 @map("thumbnail_key")
  totalClasses Int                     @default(0) @map("total_classes")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  classes      Class[]
  enrollments  EnrollmentCategory[]
  progress     ClassCategoryProgress[]

  @@map("class_categories")
}

model Class {
  id              String         @id @default(uuid()) @db.Uuid
  categoryId      String         @map("category_id") @db.Uuid
  category        ClassCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  classOrder      Int            @map("class_order")
  title           String
  subtitle        String?
  trainerName     String?        @map("trainer_name") @db.VarChar(255)
  achievements    String[]       @default([]) @db.VarChar(255)
  equipmentName   String[]       @default([]) @map("equipment_name") @db.VarChar(255)
  videoKey        String         @map("video_key")
  thumbKey        String?        @map("thumb_key")
  durationSeconds Int            @map("duration_seconds")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  progress        ClassProgress[]

  @@map("classes")
  @@unique([categoryId, classOrder])
  @@index([categoryId, classOrder])
}

model Enrollment {
  id                     String                  @id @default(uuid()) @db.Uuid
  userId                 String                  @map("user_id") @db.Uuid
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                 EnrollmentStatus        @default(ACTIVE)
  enrolledAt             DateTime                @default(now()) @map("enrolled_at")
  expiresAt              DateTime                @map("expires_at")
  expiryEmailSent        Boolean                 @default(false) @map("expiry_email_sent")
  notificationStatus     TokenDeliveryStatus     @default(PENDING) @map("notification_status")
  notificationRetryCount  Int                     @default(0) @map("notification_retry_count")
  notificationLastError   String?                 @map("notification_last_error")
  createdAt               DateTime                @default(now()) @map("created_at")
  updatedAt               DateTime                @updatedAt @map("updated_at")

  categories              EnrollmentCategory[]
  classProgress           ClassProgress[]
  categoryProgress        ClassCategoryProgress[]

  @@map("enrollments")
  @@index([userId, status])
}

model EnrollmentCategory {
  id           String        @id @default(uuid()) @db.Uuid
  enrollmentId String        @map("enrollment_id") @db.Uuid
  categoryId   String        @map("category_id") @db.Uuid
  enrollment   Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  category     ClassCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@map("enrollment_categories")
  @@unique([enrollmentId, categoryId])
}

model ClassProgress {
  id                  String     @id @default(uuid()) @db.Uuid
  enrollmentId        String     @map("enrollment_id") @db.Uuid
  classId             String     @map("class_id") @db.Uuid
  enrollment          Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  class               Class      @relation(fields: [classId], references: [id], onDelete: Cascade)
  lastWatchedSeconds  Int        @default(0) @map("last_watched_seconds")
  progressPercent     Int        @default(0) @map("progress_percent")
  isCompleted         Boolean    @default(false) @map("is_completed")
  reached50Milestone  Boolean    @default(false) @map("reached_50_milestone")
  reached75Milestone  Boolean    @default(false) @map("reached_75_milestone")
  lastWatchedAt       DateTime   @default(now()) @map("last_watched_at")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  @@map("class_progress")
  @@unique([enrollmentId, classId])
}

model ClassCategoryProgress {
  id                 String     @id @default(uuid()) @db.Uuid
  enrollmentId       String     @map("enrollment_id") @db.Uuid
  categoryId         String     @map("category_id") @db.Uuid
  enrollment         Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  category           ClassCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  progressPercent    Int        @default(0) @map("progress_percent")
  totalCompleteClass Int        @default(0) @map("total_complete_class")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  @@map("class_categories_progress")
  @@unique([enrollmentId, categoryId])
}

model Category {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  products  Product[]

  @@map("categories")
}

model Product {
  id             String    @id @default(uuid()) @db.Uuid
  categoryId     String    @map("category_id") @db.Uuid
  category       Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title          String
  description    String?
  regularPrice   Decimal   @map("regular_price") @db.Decimal(10, 2)
  discountPrice  Decimal?  @map("discount_price") @db.Decimal(10, 2)
  stockQuantity  Int       @default(0) @map("stock_quantity")
  imageKey       String?   @map("image_key")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  cartItems      CartItem[]
  orderItems     OrderItem[]

  @@map("products")
  @@index([categoryId, isActive])
}

model CartItem {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  quantity   Int      @default(1)
  updatedAt  DateTime @default(now()) @map("updated_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("add_to_cart")
  @@unique([userId, productId])
}

model Order {
  id                  String         @id @default(uuid()) @db.Uuid
  userId              String         @map("user_id") @db.Uuid
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalAmount         Decimal        @map("total_amount") @db.Decimal(10, 2)
  paymentMethod       PaymentMethod  @map("payment_method")
  paymentStatus       PaymentStatus  @default(PENDING) @map("payment_status")
  orderStatus         OrderStatus    @default(PLACED) @map("order_status")
  squareTransactionId String?        @map("square_transaction_id")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  items               OrderItem[]

  @@map("orders")
  @@index([userId, orderStatus])
}

model OrderItem {
  id              String   @id @default(uuid()) @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  quantity        Int
  priceAtPurchase Decimal  @map("price_at_purchase") @db.Decimal(10, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("order_items")
  @@index([orderId])
}

model Faq {
  id        String   @id @default(uuid()) @db.Uuid
  question  String   @db.Text
  answer    String   @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("faqs")
}