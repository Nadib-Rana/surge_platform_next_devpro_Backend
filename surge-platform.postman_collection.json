    {
      "name": "Module 5 & 6: Autopilot Scheduler & Retries",
      "description": "Autopilot queue dispatch validates a dispatchable GeneratedDraft, acquires Redis TTL lock autopilot-lock:<draftId>, forwards imageUrl/imageProvider metadata to DispatcherService, and enqueues failed publishes into FailedPostsQueue with exponential backoff.",
      "item": [
        {
          "name": "Autopilot Draft Lifecycle",
          "item": [
            {
              "name": "Create Generated Draft",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{jwtToken}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"workspaceId\": \"{{workspaceId}}\",\n  \"rawPostId\": \"{{rawPostId}}\",\n  \"promptVersionId\": \"{{promptVersionId}}\",\n  \"socialPlainText\": \"Check out this article: https://techcrunch.com/some-article\",\n  \"imageUrl\": \"{{minioAssetUrl}}\",\n  \"imageProvider\": \"openai\",\n  \"generationType\": \"manual_on_demand\",\n  \"status\": \"approved\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/generated-drafts",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "generated-drafts"
                  ]
                },
                "description": "Creates a dispatchable draft shape for Autopilot validation. imageUrl may be a real DALL-E asset or the resilient fallback PNG uploaded to MinIO; imageProvider remains openai because the provider boundary is still OpenAI even when the asset buffer falls back locally."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const requestBody = JSON.parse(pm.request.body.raw || '{}');",
                      "",
                      "pm.test('draft is dispatchable by Autopilot worker', function () {",
                      "  pm.expect(requestBody.status).to.be.oneOf(['approved', 'scheduled', 'auto_dispatch']);",
                      "});",
                      "",
                      "pm.test('asset contract supports real or fallback OpenAI image', function () {",
                      "  pm.expect(requestBody.imageUrl, 'imageUrl').to.be.a('string').and.not.empty;",
                      "  pm.expect(requestBody.imageProvider, 'imageProvider').to.eql('openai');",
                      "});",
                      "",
                      "// Worker compatibility checklist:",
                      "// 1. BullMQ job should include { workspaceId, draftId } when dispatching a specific draft.",
                      "// 2. Worker lock key is autopilot-lock:<draftId> and is released with owner-safe compare/delete.",
                      "// 3. Dispatcher payload receives images: [draft.imageUrl] and metadata.imageProvider."
                    ]
                  }
                }
              ]
            },
            {
              "name": "List Generated Drafts",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/generated-drafts",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "generated-drafts"
                  ]
                }
              }
            },
            {
              "name": "Get Generated Draft By ID",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/generated-drafts/{{generatedDraftId}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "generated-drafts",
                    "{{generatedDraftId}}"
                  ]
                }
              }
            },
            {
              "name": "Validate Dispatchable Draft Asset Contract",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{jwtToken}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/generated-drafts/{{generatedDraftId}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "generated-drafts",
                    "{{generatedDraftId}}"
                  ]
                },
                "description": "Use this before enqueueing an Autopilot dispatch job. The selected draft must belong to the workspace job payload, be dispatchable, and carry imageUrl/imageProvider consistently whether the asset came from DALL-E or the MinIO fallback path."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const json = pm.response.json();",
                      "",
                      "pm.test('selected draft id matches queue payload draftId variable', function () {",
                      "  if (json && json.id) {",
                      "    pm.expect(json.id).to.eql(pm.collectionVariables.get('generatedDraftId') || pm.environment.get('generatedDraftId'));",
                      "  }",
                      "});",
                      "",
                      "pm.test('draft status is eligible for dispatch', function () {",
                      "  if (json && json.status) {",
                      "    pm.expect(json.status).to.be.oneOf(['approved', 'scheduled', 'auto_dispatch']);",
                      "  }",
                      "});",
                      "",
                      "pm.test('image metadata is safe for dispatcher strategies', function () {",
                      "  if (json && json.imageUrl) {",
                      "    pm.expect(json.imageUrl).to.be.a('string').and.not.empty;",
                      "    pm.expect(json.imageProvider || 'openai').to.be.a('string').and.not.empty;",
                      "  }",
                      "});",
                      "",
                      "// Autopilot worker derives dispatcher payload as:",
                      "// images: draft.imageUrl ? [draft.imageUrl] : undefined",
                      "// metadata: { draftId, workspaceId, imageProvider, hasGeneratedAsset }"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Update Generated Draft",
              "request": {
                "method": "PATCH",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"status\": \"scheduled\",\n  \"imageUrl\": \"{{minioAssetUrl}}\",\n  \"imageProvider\": \"openai\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/generated-drafts/{{generatedDraftId}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "generated-drafts",
                    "{{generatedDraftId}}"
                  ]
                },
                "description": "Updates a draft into an Autopilot-eligible state. Keep imageProvider aligned with the asset pipeline output; fallback PNGs still use imageProvider=openai because the OpenAI image generation boundary triggered the fallback."
              }
            },
            {
              "name": "Delete Generated Draft",
              "request": {
                "method": "DELETE",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/generated-drafts/{{generatedDraftId}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "generated-drafts",
                    "{{generatedDraftId}}"
                  ]
                }
              }
            }
          ]
        }
      ]
