        {
          "name": "Batch Digest Aggregator & Asset Pipeline",
          "item": [
            {
              "name": "Generate Batch Digest",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{jwtToken}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"workspaceId\": \"{{workspaceId}}\",\n  \"promptVersionId\": \"{{promptVersionId}}\",\n  \"model\": \"gpt-4o-mini\",\n  \"limit\": 5\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/ai-prompts/batch-digest",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "ai-prompts",
                    "batch-digest"
                  ]
                },
                "description": "Generates a batch digest from buffered posts. Tenant-hardening expectation: workspaceId must belong to the authenticated user and promptVersionId must resolve to either a GLOBAL prompt or a WORKSPACE prompt owned by the same tenant/user. Authorization header is included as a placeholder for the future JWT guard on this endpoint."
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const requestBody = JSON.parse(pm.request.body.raw || '{}');",
                      "",
                      "pm.test('request includes tenant-scoped workspaceId', function () {",
                      "  pm.expect(requestBody.workspaceId, 'workspaceId').to.be.a('string').and.not.empty;",
                      "});",
                      "",
                      "pm.test('request includes explicit promptVersionId for template resolution', function () {",
                      "  pm.expect(requestBody.promptVersionId, 'promptVersionId').to.be.a('string').and.not.empty;",
                      "});",
                      "",
                      "pm.test('future auth context is present when JWT guard is enabled', function () {",
                      "  const authHeader = pm.request.headers.get('Authorization') || '';",
                      "  pm.expect(authHeader).to.include('Bearer');",
                      "});",
                      "",
                      "pm.test('response maps text and asset into GeneratedDraft payload', function () {",
                      "  const json = pm.response.json();",
                      "  pm.expect(json).to.have.property('draft');",
                      "  pm.expect(json).to.have.property('digestText');",
                      "  pm.expect(json).to.have.property('asset');",
                      "  pm.expect(json.draft.generationType).to.eql('batch_digest');",
                      "  pm.expect(json.draft.status).to.eql('pending');",
                      "  pm.expect(json.draft.socialPlainText).to.be.a('string').and.not.empty;",
                      "  pm.expect(json.draft.imageUrl).to.be.a('string').and.not.empty;",
                      "});",
                      "",
                      "// Tenant validation checklist for backend hardening:",
                      "// 1. workspaceId must be accessible by req.user.userId.",
                      "// 2. promptVersionId must belong to a GLOBAL prompt or a WORKSPACE prompt owned by the caller.",
                      "// 3. Never allow promptVersionId from another tenant workspace."
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
