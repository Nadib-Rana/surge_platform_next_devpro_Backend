{
  "info": {
    "name": "Surge Platform API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0",
    "_postman_id": "9b6f6d2a-0000-4c2d-8888-abcdef123456"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "jwtToken", "value": "" },
    { "key": "workspaceId", "value": "11111111-aaaa-4bbb-8ccc-abcdef123456" },
    { "key": "sourceId", "value": "33333333-cccc-4ddd-8eee-abcdef999999" },
    { "key": "rawPostId", "value": "44444444-dddd-4eee-8fff-abcdef000000" }
  ],
  "item": [
    {
      "name": "Module 1: Auth & Onboarding",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"secret123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth","register"] }
          }
        },
        {
          "name": "Verify Email (OTP)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"123456\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/verify-email", "host": ["{{baseUrl}}"], "path": ["auth","verify-email"] }
          }
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/resend-otp", "host": ["{{baseUrl}}"], "path": ["auth","resend-otp"] }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"secret123\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth","login"] }
          },
          "response": [
            {
              "name": "Sample login response",
              "originalRequest": {},
              "status": "OK",
              "code": 200,
              "_body": "{\n  \"accessToken\": \"eyJhbGci...exampletoken...\",\n  \"expiresIn\": 3600\n}"
            }
          ]
        },
        {
          "name": "Logout (protected)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/auth/logout", "host": ["{{baseUrl}}"], "path": ["auth","logout"] }
          }
        },
        {
          "name": "Request Password Reset",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"user@example.com\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/request-password-reset", "host": ["{{baseUrl}}"], "path": ["auth","request-password-reset"] }
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"token\": \"123456\",\n  \"newPassword\": \"newpass123\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["auth","reset-password"] }
          }
        }
      ]
    },
    {
      "name": "Module 2 & 3: RSS Engine & Buffer",
      "item": [
        {
          "name": "Create RSS Source",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"feedUrl\": \"https://techcrunch.com/feed/\",\n  \"description\": \"Tech news feed\"\n}" },
            "url": { "raw": "{{baseUrl}}/workspaces/{{workspaceId}}/rss-sources", "host": ["{{baseUrl}}"], "path": ["workspaces","{{workspaceId}}","rss-sources"] }
          }
        },
        {
          "name": "List RSS Sources",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/workspaces/{{workspaceId}}/rss-sources", "host": ["{{baseUrl}}"], "path": ["workspaces","{{workspaceId}}","rss-sources"] }
          }
        },
        {
          "name": "Delete RSS Source (soft/hard)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/workspaces/{{workspaceId}}/rss-sources/{{sourceId}}?force=true", "host": ["{{baseUrl}}"], "path": ["workspaces","{{workspaceId}}","rss-sources","{{sourceId}}"], "query": [{ "key": "force", "value": "true" }] }
          }
        },
        {
          "name": "Update Queue Config",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"fetchFrequencyHours\": 6,\n  \"postingTimes\": [\"09:00\", \"17:00\"]\n}" },
            "url": { "raw": "{{baseUrl}}/workspaces/{{workspaceId}}/queue-config", "host": ["{{baseUrl}}"], "path": ["workspaces","{{workspaceId}}","queue-config"] }
          }
        },
        {
          "name": "Get Buffered Posts (workspace)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/workspaces/{{workspaceId}}/buffer-posts?days=3", "host": ["{{baseUrl}}"], "path": ["workspaces","{{workspaceId}}","buffer-posts"], "query": [{ "key": "days", "value": "3" }] }
          }
        },
        {
          "name": "Get All Raw Posts",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/raw-posts", "host": ["{{baseUrl}}"], "path": ["raw-posts"] }
          }
        },
        {
          "name": "Get Raw Post By ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": { "raw": "{{baseUrl}}/raw-posts/{{rawPostId}}", "host": ["{{baseUrl}}"], "path": ["raw-posts","{{rawPostId}}"] }
          }
        },
        {
          "name": "Create RSS Feed (admin) - aligns to Prisma RssFeed",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"workspaceId\": \"11111111-aaaa-4bbb-8ccc-abcdef123456\",\n  \"feedUrl\": \"https://techcrunch.com/feed/\"\n}" },
            "url": { "raw": "{{baseUrl}}/rss-feeds", "host": ["{{baseUrl}}"], "path": ["rss-feeds"] }
          }
        }
      ]
    },
    {
      "name": "Module 4 & 5 & 7: AI Creative & Dispatch Engine",
      "item": [
        {
          "name": "Create AI Prompt",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"workspaceId\": \"11111111-aaaa-4bbb-8ccc-abcdef123456\",\n  \"name\": \"Daily Tech Digest\",\n  \"description\": \"Combine top items into a digest\"\n}" },
            "url": { "raw": "{{baseUrl}}/ai-prompts", "host": ["{{baseUrl}}"], "path": ["ai-prompts"] }
          }
        },
        {
          "name": "Generate Batch Digest",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"workspaceId\": \"11111111-aaaa-4bbb-8ccc-abcdef123456\",\n  \"limit\": 5,\n  \"model\": \"gpt-4o-mini\"\n}" },
            "url": { "raw": "{{baseUrl}}/ai-prompts/batch-digest", "host": ["{{baseUrl}}"], "path": ["ai-prompts","batch-digest"] }
          }
        },
        {
          "name": "List AI Prompts",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }], "url": { "raw": "{{baseUrl}}/ai-prompts", "host": ["{{baseUrl}}"], "path": ["ai-prompts"] } }
        },
        {
          "name": "Create Generated Draft",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"workspaceId\": \"11111111-aaaa-4bbb-8ccc-abcdef123456\",\n  \"promptVersionId\": \"22222222-bbbb-4ccc-8ddd-abcdef654321\",\n  \"socialPlainText\": \"Check out this article: https://techcrunch.com/some-article\",\n  \"imageUrl\": \"https://images.example.com/ai-generated-1.jpg\",\n  \"generationType\": \"manual_on_demand\"\n}" },
            "url": { "raw": "{{baseUrl}}/generated-drafts", "host": ["{{baseUrl}}"], "path": ["generated-drafts"] }
          }
        },
        {
          "name": "List Generated Drafts",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }], "url": { "raw": "{{baseUrl}}/generated-drafts", "host": ["{{baseUrl}}"], "path": ["generated-drafts"] } }
        },
        {
          "name": "Create Publishing Channel (workspace)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"workspaceId\": \"11111111-aaaa-4bbb-8ccc-abcdef123456\",\n  \"platform\": \"wordpress\",\n  \"encryptedCredentials\": \"{\\\"siteUrl\\\":\\\"https://example.com\\\",\\\"accessToken\\\":\\\"token_here\\\"}\"\n}" },
            "url": { "raw": "{{baseUrl}}/publishing-channels", "host": ["{{baseUrl}}"], "path": ["publishing-channels"] }
          }
        },
        {
          "name": "List Publishing Channels",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }], "url": { "raw": "{{baseUrl}}/publishing-channels", "host": ["{{baseUrl}}"], "path": ["publishing-channels"] } }
        },
        {
          "name": "Dispatch: Publish (protected)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"channel\": \"wordpress\",\n  \"title\": \"AI Daily Digest: Top Stories\",\n  \"content\": \"<h1>Today's Highlights</h1><p>Automated digest content goes here.</p>\",\n  \"images\": [\"https://images.example.com/ai-generated-1.jpg\"],\n  \"credentials\": {\n    \"apiUrl\": \"https://example.com\",\n    \"accessToken\": \"wp_token_here\",\n    \"target\": \"\"\n  },\n  \"metadata\": { \"status\": \"publish\" }\n}"
            },
            "url": { "raw": "{{baseUrl}}/workspaces/{{workspaceId}}/dispatcher/publish", "host": ["{{baseUrl}}"], "path": ["workspaces","{{workspaceId}}","dispatcher","publish"] }
          }
        }
      ]
    }
  ]
}
